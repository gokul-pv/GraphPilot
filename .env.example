# GraphPilot configuration.

# ─────────────────────────────────────────────────────────────────────────────
# Providers
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

WANDB_API_KEY=
WANDB_PROJECT=
WANDB_MODEL=moonshotai/Kimi-K2.6

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b

LLM_ORDER=gemini,wandb,groq,openrouter,nvidia,ollama

# ─────────────────────────────────────────────────────────────────────────────
# Routing
# ─────────────────────────────────────────────────────────────────────────────
ROUTER_ORDER=groq,wandb,nvidia

ROUTER_GROQ_MODEL=llama-3.3-70b-versatile
ROUTER_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
ROUTER_WANDB_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_FALLBACK_PROVIDER=gemini
EMBED_FALLBACK_MODEL=gemini-embedding-001
EMBED_ORDER=ollama,gemini

# ─────────────────────────────────────────────────────────────────────────────
# Tools
# ─────────────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=
AGENT_API_PORT=
